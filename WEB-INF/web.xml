<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Movie Booking App</display-name>

    <!-- Context Param Example (optional) -->
    <!--
    <context-param>
        <param-name>configFile</param-name>
        <param-value>/WEB-INF/app.properties</param-value>
    </context-param>
    -->

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookSeatsServlet</servlet-name>
        <servlet-class>BookSeatsServlet</servlet-class>
    </servlet>
    <!-- Example: seat selection and showtimes -->
    <servlet>
        <servlet-name>SeatBookingServlet</servlet-name>
        <servlet-class>SeatBookingServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ShowtimesServlet</servlet-name>
        <servlet-class>ShowtimesServlet</servlet-class>
    </servlet>

    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookSeatsServlet</servlet-name>
        <url-pattern>/BookSeatsServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SeatBookingServlet</servlet-name>
        <url-pattern>/SeatBookingServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShowtimesServlet</servlet-name>
        <url-pattern>/ShowtimesServlet</url-pattern>
    </servlet-mapping>

    <!-- Example: Add filters, listeners, or error-pages as needed -->

</web-app>



